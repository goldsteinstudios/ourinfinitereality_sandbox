node_modules/
.DS_Store
.env
*.log
dist/
build/

# Astro build cache
.astro/

# MkDocs build output
site/

# Python cache
__pycache__/
*.pyc

# Directories removed from main (live on other branches)
# data/ is excluded per-child rather than wholesale, so the canonical glyph
# corpus can be re-included. A blanket `data/` cannot be negated: git does not
# descend into an excluded directory, so `!data/...` under it has no effect.
data/*
!data/ddj/
data/ddj/*
!data/ddj/Guodian Strip Glyphs/
research/
output/

# Generated bundles and docsets
docset_*.md
notebooklm_bundle_*/
notebooklm_docs/
*.zip

# Session transport (git bundles) — history, not content
*.bundle
